#!/usr/bin/env bash

# ==========================================
# MyHost v2.0 - Cross-Platform Minecraft Host
# Compatible: Android (Termux) & PC (Linux/macOS/WSL)
# ==========================================

# 1. PATH AUTO-FIX (Prevents "command not found" in Termux/Linux)
if [[ ":$PATH:" != *":$HOME/bin:"* ]]; then
    export PATH="$HOME/bin:$PATH"
fi

# 2. DETECT PLATFORM & SET STORAGE PATHS
if [ -d "/sdcard" ]; then
    PLATFORM="MOBILE"
    BASE_DIR="/sdcard/MyHost"
else
    PLATFORM="PC"
    BASE_DIR="$HOME/Documents/MyHost"
fi

mkdir -p "$BASE_DIR"

# 3. HELPER FUNCTIONS

# Display header banner
show_header() {
    clear
    echo "=================================================="
    echo "            MyHost Server Manager v2.0            "
    echo "            Platform Mode: $PLATFORM              "
    echo "=================================================="
    echo " Storage Path: $BASE_DIR"
    echo "--------------------------------------------------"
}

# Ensure screen/whiptail dependencies are present
check_deps() {
    local missing=()
    command -v screen &>/dev/null || missing+=("screen")
    command -v whiptail &>/dev/null || missing+=("whiptail")
    command -v curl &>/dev/null || missing+=("curl")
    command -v java &>/dev/null || missing+=("openjdk-21")

    if [ ${#missing[@]} -ne 0 ]; then
        echo "[!] Missing dependencies: ${missing[*]}"
        echo "[!] Run install.sh or install missing packages manually."
    fi
}

# Create a new server
create_server() {
    local SERVER_NAME="$1"
    if [ -z "$SERVER_NAME" ]; then
        read -rp "Enter new server name: " SERVER_NAME
    fi

    if [ -z "$SERVER_NAME" ]; then
        echo "[!] Server name cannot be empty."
        read -rp "Press Enter to return..."
        return
    fi

    local SERVER_DIR="$BASE_DIR/$SERVER_NAME"

    if [ -d "$SERVER_DIR" ]; then
        echo "[!] A server named '$SERVER_NAME' already exists!"
        read -rp "Press Enter to return..."
        return
    fi

    mkdir -p "$SERVER_DIR/plugins"
    echo "[*] Creating server folder at $SERVER_DIR..."

    # Fetch latest PaperMC 1.20.4 build as default engine
    echo "[*] Downloading Paper Minecraft Server JAR..."
    curl -o "$SERVER_DIR/server.jar" https://api.papermc.io/v2/projects/paper/versions/1.20.4/builds/496/downloads/paper-1.20.4-496.jar

    # Accept EULA automatically
    echo "eula=true" > "$SERVER_DIR/eula.txt"

    echo "[✔] Server '$SERVER_NAME' created successfully!"
    echo "To start it, select 'Start Server' from the main menu."
    read -rp "Press Enter to return..."
}

# List existing servers
list_servers() {
    show_header
    echo "Available Servers:"
    echo "------------------"
    local count=0
    for dir in "$BASE_DIR"/*/; do
        if [ -d "$dir" ]; then
            local sname
            sname=$(basename "$dir")
            echo " - $sname"
            count=$((count+1))
        fi
    done

    if [ $count -eq 0 ]; then
        echo " (No servers found)"
    fi
    echo ""
}

# Start server using screen
start_server() {
    local SERVER_NAME="$1"
    local RAM="${2:-2G}"

    if [ -z "$SERVER_NAME" ]; then
        list_servers
        read -rp "Enter server name to start: " SERVER_NAME
    fi

    local SERVER_DIR="$BASE_DIR/$SERVER_NAME"

    if [ ! -d "$SERVER_DIR" ]; then
        echo "[!] Server '$SERVER_NAME' does not exist."
        read -rp "Press Enter to return..."
        return
    fi

    if screen -list | grep -q "myhost_${SERVER_NAME}"; then
        echo "[!] Server '$SERVER_NAME' is ALREADY running!"
        read -rp "Press Enter to return..."
        return
    fi

    echo "[*] Starting server '$SERVER_NAME' with $RAM RAM in background..."
    cd "$SERVER_DIR" || return
    screen -dmS "myhost_${SERVER_NAME}" java -Xms${RAM} -Xmx${RAM} -jar server.jar nogui

    echo "[✔] Server started successfully!"
    echo "Use 'Console' from the main menu to view live server logs."
    read -rp "Press Enter to return..."
}

# Open live console session
open_console() {
    local SERVER_NAME="$1"

    if [ -z "$SERVER_NAME" ]; then
        list_servers
        read -rp "Enter server name to open console: " SERVER_NAME
    fi

    if screen -list | grep -q "myhost_${SERVER_NAME}"; then
        echo "[*] Connecting to console... (Press CTRL+A then D to detach without closing server)"
        sleep 1
        screen -r "myhost_${SERVER_NAME}"
    else
        echo "[!] Server '$SERVER_NAME' is not running."
        read -rp "Press Enter to return..."
    fi
}

# Direct command line arguments support (CLI interface)
case "$1" in
    list)
        list_servers
        exit 0
        ;;
    create)
        create_server "$2"
        exit 0
        ;;
    start)
        start_server "$2" "$3"
        exit 0
        ;;
    console)
        open_console "$2"
        exit 0
        ;;
esac

# 4. INTERACTIVE MENU INTERFACE (TUI)
check_deps

while true; do
    show_header
    echo "1) Create New Server"
    echo "2) Start Server"
    echo "3) Open Server Console"
    echo "4) List Servers"
    echo "5) Exit"
    echo "--------------------------------------------------"
    read -rp "Select an option [1-5]: " CHOICE

    case "$CHOICE" in
        1)
            create_server
            ;;
        2)
            start_server
            ;;
        3)
            open_console
            ;;
        4)
            list_servers
            read -rp "Press Enter to return..."
            ;;
        5)
            echo "Exiting MyHost."
            exit 0
            ;;
        *)
            echo "Invalid option."
            sleep 1
            ;;
    esac
done
