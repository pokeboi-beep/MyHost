#!/usr/bin/env bash

# =====================================================================
# MYHOST v4.1 - ADVANCED MINECRAFT SERVER MANAGEMENT ENGINE
# Features: Dynamic API Build Resolution, Cross-Platform Noexec Bypass
# =====================================================================

set -e

# -------------------------------------------------------------------
# 0. ENVIRONMENT & STORAGE RESOLUTION
# -------------------------------------------------------------------
if [[ ":$PATH:" != *":$HOME/bin:"* ]]; then
    export PATH="$HOME/bin:$PATH"
fi

# Prevent noexec storage failures on Android Termux
if command -v pkg &>/dev/null || [ -d "/sdcard" ]; then
    PLATFORM="ANDROID"
    # Execute within Termux internal HOME to guarantee execution permissions
    STORAGE_ROOT="$HOME/MyHost"
else
    PLATFORM="PC"
    if [ -d "$HOME/Documents" ]; then
        STORAGE_ROOT="$HOME/Documents/MyHost"
    else
        STORAGE_ROOT="$HOME/MyHost"
    fi
fi

mkdir -p "$STORAGE_ROOT" 2>/dev/null

# -------------------------------------------------------------------
# 1. HARDWARE ANALYSIS & HEALTH CHECKS
# -------------------------------------------------------------------
get_recommended_ram() {
    if [ "$PLATFORM" == "ANDROID" ]; then
        echo "2G"
    else
        local TOTAL_KB
        TOTAL_KB=$(grep MemTotal /proc/meminfo 2>/dev/null | awk '{print $2}')
        if [ -n "$TOTAL_KB" ]; then
            local RAM_GB=$((TOTAL_KB / 1024 / 1024 / 2))
            [ "$RAM_GB" -lt 2 ] && RAM_GB=2
            echo "${RAM_GB}G"
        else
            echo "4G"
        fi
    fi
}

check_dependencies() {
    local MISSING=()
    command -v curl &>/dev/null || MISSING+=("curl")
    command -v screen &>/dev/null || MISSING+=("screen")
    command -v whiptail &>/dev/null || MISSING+=("whiptail")
    command -v java &>/dev/null || MISSING+=("openjdk-21")
    command -v jq &>/dev/null || MISSING+=("jq")

    if [ ${#MISSING[@]} -ne 0 ]; then
        whiptail --title "System Requirement Warning" --msgbox "Missing required tools: ${MISSING[*]}\n\nPlease install missing dependencies using your system package manager." 10 65
    fi
}

# -------------------------------------------------------------------
# 2. DYNAMIC SERVER ENGINE DEPLOYMENT
# -------------------------------------------------------------------
download_engine() {
    local TARGET_DIR="$1"
    local ENGINE_TYPE="$2"
    local VERSION="${3:-1.20.4}"

    mkdir -p "$TARGET_DIR"

    case "$ENGINE_TYPE" in
        "PaperMC")
            echo "[*] Fetching build information for PaperMC ${VERSION}..."
            local LATEST_BUILD
            LATEST_BUILD=$(curl -sSL "https://api.papermc.io/v2/projects/paper/versions/${VERSION}" | jq -r '.builds[-1]' 2>/dev/null || echo "")

            if [ -n "$LATEST_BUILD" ] && [ "$LATEST_BUILD" != "null" ]; then
                echo "[*] Downloading PaperMC build #${LATEST_BUILD} for Minecraft ${VERSION}..."
                curl -fsSL -o "$TARGET_DIR/server.jar" "https://api.papermc.io/v2/projects/paper/versions/${VERSION}/builds/${LATEST_BUILD}/downloads/paper-${VERSION}-${LATEST_BUILD}.jar"
            else
                echo "[!] Requested version build not found. Falling back to Paper 1.20.4 stable..."
                curl -fsSL -o "$TARGET_DIR/server.jar" "https://api.papermc.io/v2/projects/paper/versions/1.20.4/builds/496/downloads/paper-1.20.4-496.jar"
            fi
            ;;

        "Purpur")
            echo "[*] Fetching Purpur build for ${VERSION}..."
            curl -fsSL -o "$TARGET_DIR/server.jar" "https://api.purpurmc.org/v2/purpur/${VERSION}/latest/download" || \
            curl -fsSL -o "$TARGET_DIR/server.jar" "https://api.purpurmc.org/v2/purpur/1.20.4/latest/download"
            ;;

        "Velocity")
            echo "[*] Fetching latest Velocity Proxy core..."
            local VEL_BUILD
            VEL_BUILD=$(curl -sSL "https://api.papermc.io/v2/projects/velocity/versions/3.3.0-SNAPSHOT" | jq -r '.builds[-1]' 2>/dev/null || echo "434")
            curl -fsSL -o "$TARGET_DIR/server.jar" "https://api.papermc.io/v2/projects/velocity/versions/3.3.0-SNAPSHOT/builds/${VEL_BUILD}/downloads/velocity-3.3.0-SNAPSHOT-${VEL_BUILD}.jar"
            ;;

        "Fabric")
            echo "[*] Fetching Fabric Loader for ${VERSION}..."
            curl -fsSL -o "$TARGET_DIR/server.jar" "https://meta.fabricmc.net/v2/versions/loader/${VERSION}/0.15.7/1.0.1/server/jar"
            ;;
    esac

    # Ensure downloaded file is valid and non-empty
    if [ ! -s "$TARGET_DIR/server.jar" ]; then
        echo "[!] Error: Failed to download valid server JAR file."
        rm -f "$TARGET_DIR/server.jar"
        return 1
    fi

    # EULA acceptance
    echo "eula=true" > "$TARGET_DIR/eula.txt"

    # Standard configuration bootstrap
    if [ ! -f "$TARGET_DIR/server.properties" ]; then
        cat << 'PROPS' > "$TARGET_DIR/server.properties"
server-port=25565
motd=MyHost Powered Instance
gamemode=survival
max-players=20
online-mode=true
enable-command-block=true
view-distance=8
simulation-distance=6
PROPS
    fi
}

# -------------------------------------------------------------------
# 3. INTERACTIVE TUI CONTROLLER (Whiptail GUI)
# -------------------------------------------------------------------
ui_create_instance() {
    local SNAME
    SNAME=$(whiptail --title "New Server Instance" --inputbox "Enter server instance name:" 8 60 "Survival_Server" 3>&1 1>&2 2>&3)
    [ -z "$SNAME" ] && return

    local SDIR="$STORAGE_ROOT/$SNAME"
    if [ -d "$SDIR" ]; then
        whiptail --title "Error" --msgbox "Instance '$SNAME' already exists." 8 60
        return
    fi

    local ENGINE
    ENGINE=$(whiptail --title "Select Engine Type" --menu "Choose Minecraft server software architecture:" 14 65 4 \
    "PaperMC" "High performance Bukkit/Spigot engine (Recommended)" \
    "Purpur" "Highly customizable fork of PaperMC" \
    "Fabric" "Lightweight modded server software" \
    "Velocity" "High-speed network proxy core" 3>&1 1>&2 2>&3)

    [ -z "$ENGINE" ] && return

    local VERSION
    VERSION=$(whiptail --title "Minecraft Version" --inputbox "Enter target Minecraft version (e.g. 1.20.4, 1.20.2):" 8 60 "1.20.4" 3>&1 1>&2 2>&3)
    [ -z "$VERSION" ] && VERSION="1.20.4"

    whiptail --title "Downloading Core" --infobox "Deploying $ENGINE ($VERSION) core to instance directory..." 8 60
    download_engine "$SDIR" "$ENGINE" "$VERSION"

    if [ -f "$SDIR/server.jar" ]; then
        whiptail --title "Setup Complete" --msgbox "Instance '$SNAME' successfully built.\n\nPath: $SDIR" 9 65
    else
        whiptail --title "Setup Failed" --msgbox "Failed to download $ENGINE for version $VERSION." 8 60
    fi
}

ui_manage_instances() {
    local SERVERS
    SERVERS=$(ls -d "$STORAGE_ROOT"/*/ 2>/dev/null | xargs -n1 basename 2>/dev/null)

    if [ -z "$SERVERS" ]; then
        whiptail --title "No Instances" --msgbox "No active server instances found in:\n$STORAGE_ROOT" 9 65
        return
    fi

    local MENU_OPTS=()
    for s in $SERVERS; do
        local STATUS="[OFFLINE]"
        if screen -list | grep -q "myhost_${s}"; then
            STATUS="[ONLINE]"
        fi
        MENU_OPTS+=("$s" "$STATUS")
    done

    local TARGET
    TARGET=$(whiptail --title "Instance Dashboard" --menu "Select a server instance:" 16 65 6 "${MENU_OPTS[@]}" 3>&1 1>&2 2>&3)
    [ -z "$TARGET" ] && return

    local ACTION
    ACTION=$(whiptail --title "Manage: $TARGET" --menu "Select operation:" 15 65 6 \
    "Start" "Boot instance with optimized Aikar JVM flags" \
    "Console" "Attach to real-time interactive server terminal" \
    "Stop" "Send graceful save-and-stop signal" \
    "Kill" "Force terminate frozen process" \
    "Diagnose" "Test direct Java startup output for errors" \
    "Delete" "Permanently wipe instance directory" 3>&1 1>&2 2>&3)

    local SDIR="$STORAGE_ROOT/$TARGET"

    case "$ACTION" in
        Start)
            if screen -list | grep -q "myhost_${TARGET}"; then
                whiptail --title "Notice" --msgbox "Instance '$TARGET' is already running." 8 60
                return
            fi

            local SUGGESTED_RAM
            SUGGESTED_RAM=$(get_recommended_ram)
            local RAM
            RAM=$(whiptail --title "RAM Allocation" --inputbox "Enter maximum RAM (e.g. 1G, 2G, 4G):" 8 60 "$SUGGESTED_RAM" 3>&1 1>&2 2>&3)
            [ -z "$RAM" ] && RAM="$SUGGESTED_RAM"

            if [ ! -f "$SDIR/server.jar" ]; then
                whiptail --title "Error" --msgbox "Missing server.jar inside $SDIR" 8 60
                return
            fi

            cd "$SDIR"
            screen -dmS "myhost_${TARGET}" java -Xms1G -Xmx"${RAM}" -XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -jar server.jar nogui

            sleep 1.5
            if screen -list | grep -q "myhost_${TARGET}"; then
                whiptail --title "Boot Successful" --msgbox "Instance '$TARGET' launched with $RAM RAM.\n\nSelect 'Console' to view boot sequence." 9 65
            else
                whiptail --title "Launch Failed" --msgbox "Server failed to start in screen background.\n\nRun 'Diagnose' option to inspect execution logs." 10 65
            fi
            ;;

        Console)
            if screen -list | grep -q "myhost_${TARGET}"; then
                screen -r "myhost_${TARGET}"
            else
                whiptail --title "Offline" --msgbox "Instance '$TARGET' is not currently active." 8 60
            fi
            ;;

        Stop)
            if screen -list | grep -q "myhost_${TARGET}"; then
                screen -S "myhost_${TARGET}" -X stuff 'stop\n'
                whiptail --title "Shutdown Signal" --msgbox "Graceful stop command dispatched to '$TARGET'." 8 60
            else
                whiptail --title "Offline" --msgbox "Instance '$TARGET' is not currently active." 8 60
            fi
            ;;

        Kill)
            if screen -list | grep -q "myhost_${TARGET}"; then
                screen -S "myhost_${TARGET}" -X quit
                whiptail --title "Terminated" --msgbox "Process screen 'myhost_${TARGET}' killed." 8 60
            fi
            ;;

        Diagnose)
            clear
            echo "=================================================="
            echo " DIAGNOSTIC MODE: Running Java manually..."
            echo " Location: $SDIR"
            echo "=================================================="
            cd "$SDIR"
            echo "eula=true" > eula.txt
            java -Xms1G -Xmx2G -jar server.jar nogui
            echo "=================================================="
            read -rp "Diagnostic completed. Press Enter to exit..."
            ;;

        Delete)
            if whiptail --title "Confirm Deletion" --yesno "Are you sure you want to delete '$TARGET'?\nAll world files and configurations will be lost." 9 65; then
                rm -rf "$SDIR"
                whiptail --title "Instance Removed" --msgbox "Instance '$TARGET' wiped from storage." 8 60
            fi
            ;;
    esac
}

ui_plugin_store() {
    local SERVERS
    SERVERS=$(ls -d "$STORAGE_ROOT"/*/ 2>/dev/null | xargs -n1 basename 2>/dev/null)
    if [ -z "$SERVERS" ]; then
        whiptail --title "Error" --msgbox "Deploy an instance before installing plugins." 8 60
        return
    fi

    local MENU_OPTS=()
    for s in $SERVERS; do MENU_OPTS+=("$s" "Target instance"); done

    local TARGET
    TARGET=$(whiptail --title "Plugin Manager" --menu "Select target instance:" 15 60 4 "${MENU_OPTS[@]}" 3>&1 1>&2 2>&3)
    [ -z "$TARGET" ] && return

    local PDIR="$STORAGE_ROOT/$TARGET/plugins"
    mkdir -p "$PDIR"

    local PLUGIN
    PLUGIN=$(whiptail --title "Addons & Plugins" --menu "Select package to install:" 15 70 5 \
    "GeyserMC" "Allows Bedrock/Mobile players to connect" \
    "EssentialsX" "Economy, teleports, and core commands" \
    "ViaVersion" "Allows legacy and newer clients to connect" \
    "LuckPerms" "Permission ranks and role management" \
    "WorldEdit" "In-game world editing & terraforming" 3>&1 1>&2 2>&3)

    [ -z "$PLUGIN" ] && return

    whiptail --title "Downloading Plugin" --infobox "Fetching $PLUGIN..." 8 60

    case "$PLUGIN" in
        GeyserMC)
            curl -sSL -o "$PDIR/Geyser-Paper.jar" https://download.geysermc.org/v2/projects/geyser/versions/latest/builds/latest/downloads/spigot
            curl -sSL -o "$PDIR/Floodgate.jar" https://download.geysermc.org/v2/projects/floodgate/versions/latest/builds/latest/downloads/spigot
            ;;
        EssentialsX)
            curl -sSL -o "$PDIR/EssentialsX.jar" https://github.com/EssentialsX/Essentials/releases/download/2.20.1/EssentialsX-2.20.1.jar
            ;;
        ViaVersion)
            curl -sSL -o "$PDIR/ViaVersion.jar" https://hangarcdn.papermc.io/plugins/ViaVersion/ViaVersion/versions/4.9.2/PAPER/ViaVersion-4.9.2.jar
            ;;
        LuckPerms)
            curl -sSL -o "$PDIR/LuckPerms.jar" https://download.luckperms.net/1550/bukkit/loader/LuckPerms-Bukkit-5.4.143.jar
            ;;
        WorldEdit)
            curl -sSL -o "$PDIR/WorldEdit.jar" https://cdn.modrinth.com/data/1eAoo2hA/versions/e77G7u6W/worldedit-bukkit-7.3.0.jar
            ;;
    esac

    whiptail --title "Installed" --msgbox "$PLUGIN successfully saved to:\n$PDIR" 9 65
}

# -------------------------------------------------------------------
# 4. MAIN PROGRAM ROUTER
# -------------------------------------------------------------------
check_dependencies

while true; do
    CHOICE=$(whiptail --title "MyHost v4.1 - Engine [$PLATFORM]" --menu \
    "Storage Root: $STORAGE_ROOT\nSelect menu option:" 18 70 5 \
    "1" "Create New Instance (Paper / Purpur / Fabric / Velocity)" \
    "2" "Instance Dashboard (Start, Console, Stop, Diagnose)" \
    "3" "Plugin Store (GeyserMC, Essentials, ViaVersion)" \
    "4" "Edit Instance Config (server.properties)" \
    "5" "Exit Engine" 3>&1 1>&2 2>&3)

    case "$CHOICE" in
        1) ui_create_instance ;;
        2) ui_manage_instances ;;
        3) ui_plugin_store ;;
        4)
            SERVERS=$(ls -d "$STORAGE_ROOT"/*/ 2>/dev/null | xargs -n1 basename 2>/dev/null)
            if [ -n "$SERVERS" ]; then
                MENU_OPTS=()
                for s in $SERVERS; do MENU_OPTS+=("$s" "Edit properties"); done
                TGT=$(whiptail --title "Config Editor" --menu "Select instance:" 15 60 4 "${MENU_OPTS[@]}" 3>&1 1>&2 2>&3)
                [ -n "$TGT" ] && nano "$STORAGE_ROOT/$TGT/server.properties"
            fi
            ;;
        5) clear; exit 0 ;;
        *) clear; exit 0 ;;
    esac
done
